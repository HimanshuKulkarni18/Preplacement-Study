4. Sort a list without using sort() (bubble sort)
python
lst = [int(x) for x in input("Enter numbers separated by space: ").split()]

n = len(lst)
for i in range(n):
    for j in range(0, n - i - 1):
        if lst[j] > lst[j + 1]:
            lst[j], lst[j + 1] = lst[j + 1], lst[j]
print("Sorted:", lst)


