#2. Count words in a sentence

s = input("Enter a sentence: ")
count = 0
in_word = False
for ch in s:
    if ch != " ":
        if not in_word:
            count += 1
            in_word = True
    else:
        in_word = False
print("Words =", count)

#3 .Find the frequency of characters in a string

s = input("Enter a string: ")
freq = {}
for ch in s:
    freq[ch] = freq.get(ch, 0) + 1

for ch, f in freq.items():
    print(f"'{ch}':", f)

